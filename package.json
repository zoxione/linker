{
  "name": "linker",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -- turbo dev",
    "build": "dotenv -- turbo build",
    "start": "dotenv -- turbo start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,mts,md,mdx,json}\"",
    "typegen": "dotenv -- turbo typegen && pnpm run format",
    "auth:generate": "dotenv -- turbo auth:generate",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "dotenv-cli": "github:motdotla/dotenv-cli",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "turbo": "2.6.1"
  }
}
