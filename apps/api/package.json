{
  "name": "@repo/api",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx dist/server/index.js",
    "auth:generate": "pnpm dlx @better-auth/cli generate --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "1.19.1",
    "@hono/swagger-ui": "0.5.2",
    "@hono/zod-openapi": "1.1.0",
    "@scalar/hono-api-reference": "0.9.16",
    "accept-language-parser": "1.5.0",
    "better-auth": "1.3.9",
    "dayjs": "1.11.18",
    "drizzle-orm": "0.44.5",
    "hono": "4.9.6",
    "hono-pino": "0.10.2",
    "nanoid": "5.1.5",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "ua-parser-js": "2.0.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/accept-language-parser": "1.5.8",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
