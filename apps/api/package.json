{
  "name": "@repo/api",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx dist/server/index.js",
    "lint": "eslint .",
    "auth:generate": "pnpm dlx @better-auth/cli generate --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "1.19.7",
    "@hono/swagger-ui": "0.5.3",
    "@hono/zod-openapi": "1.2.0",
    "@scalar/hono-api-reference": "0.9.30",
    "accept-language-parser": "1.5.0",
    "better-auth": "1.4.10",
    "dayjs": "1.11.19",
    "drizzle-orm": "0.45.1",
    "hono": "4.11.3",
    "hono-pino": "0.10.3",
    "nanoid": "5.1.6",
    "nodemailer": "7.0.12",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "ua-parser-js": "2.0.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/accept-language-parser": "1.5.8",
    "@types/node": "25.0.3",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.16.0",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
